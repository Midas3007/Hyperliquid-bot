# ---- HEVI: required ----------------------------------------------------------
TELEGRAM_BOT_TOKEN=          # from @BotFather
TELEGRAM_CHAT_ID=            # leave empty first; HEVI tells you your id when you message it
ANTHROPIC_API_KEY=           # from console.anthropic.com

# ---- trading mode --------------------------------------------------------------
# prove (default): paper-trade on live prices until the paper record passes the go-live gate in protocol.toml
#                  ([autopilot] go_live_*), then switch to real money automatically. Needs the two HL_* keys
#                  below to go live; without them HEVI keeps paper trading and tells you when it's ready.
# paper:           simulated fills only, forever
# live:            real money from the first trade (skips the proof)
MODE=prove
PAPER_BALANCE=100            # starting balance of the simulated account

# ---- Hyperliquid wallet (needed for MODE=live, and for MODE=prove to go live) ------
HL_ACCOUNT_ADDRESS=          # your MAIN Hyperliquid wallet address (0x...) - the one holding the USDC
HL_API_PRIVATE_KEY=          # private key of the API wallet from app.hyperliquid.xyz/API (can trade, cannot withdraw)

# ---- public track record (optional) ----------------------------------------------
# HEVI publishes its trades (no wallet address, no keys) to a page on Netlify backed by Neon. See record-site/.
RECORD_URL=                  # e.g. https://hevi-record-midart.vercel.app
RECORD_TOKEN=                # the upload token (its SHA-256 is stored in the site's database)

# ---- optional ------------------------------------------------------------------
HL_NETWORK=mainnet           # mainnet | testnet
# DATA_DIR=./data   # where HEVI keeps its memory. Leave it unset: phones use ./data, Railway uses the volume
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high
WHALE_CACHE_MIN=10           # leaderboard refresh; capped below the protocol's 15-minute staleness limit
# PROTOCOL_FILE=./my-protocol.toml   # your own copy of the thresholds (default: protocol.toml)
# CALENDAR_FILE=./calendar.toml      # manual macro-event fallback (the live feed is used first)
#
# Every protocol threshold (risk %, BTC bands, filters, schedule, breakers, autopilot) lives in protocol.toml.
# Pause/resume HEVI from Telegram with /pause and /resume. All protocol times are UTC.
