# ---- required ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=          # from @BotFather
TELEGRAM_CHAT_ID=            # leave empty first; the bot tells you your id when you message it
HL_ACCOUNT_ADDRESS=          # your MAIN Hyperliquid wallet address (0x...) - the one holding the USDC
HL_API_PRIVATE_KEY=          # private key of the API wallet created at app.hyperliquid.xyz/API (can trade, cannot withdraw)
ANTHROPIC_API_KEY=           # from console.anthropic.com

# ---- paper trading (live prices, simulated fills - no wallet or real money needed) ----
PAPER_TRADING=false          # true = paper mode; the two HL_* variables above can stay empty
PAPER_BALANCE=100            # starting balance of the simulated account

# ---- optional ---------------------------------------------------------------
HL_NETWORK=mainnet           # mainnet | testnet
DATA_DIR=/data               # where the journal database lives (mount a volume here)
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high
WHALE_CACHE_MIN=10           # leaderboard refresh; capped below the protocol's 15-minute staleness limit
# PROTOCOL_FILE=/data/protocol.toml   # use your own copy of the thresholds (default: protocol.toml in the image)
# CALENDAR_FILE=/data/calendar.toml   # keep the event calendar on the volume so you can edit it without redeploying
#
# Every protocol threshold (risk %, BTC bands, filters, schedule, breakers...) lives in protocol.toml, not here.
# All protocol times are UTC.
