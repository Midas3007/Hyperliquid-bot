# ---- required ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=          # from @BotFather
TELEGRAM_CHAT_ID=            # leave empty first; the bot tells you your id when you message it
HL_ACCOUNT_ADDRESS=          # your MAIN Hyperliquid wallet address (0x...) - the one holding the USDC
HL_API_PRIVATE_KEY=          # private key of the API wallet created at app.hyperliquid.xyz/API (can trade, cannot withdraw)
ANTHROPIC_API_KEY=           # from console.anthropic.com

# ---- optional ---------------------------------------------------------------
HL_NETWORK=mainnet           # mainnet | testnet
TIMEZONE=UTC                 # e.g. Africa/Lagos, Europe/London - drives Mon-Fri + Friday close times
SIZING_MODE=B                # B = capped risk (default), A = protocol (80-85% margin, 15-25x)
MODE_B_RISK_PCT=15           # mode B: % of account lost if the SL is hit
MODE_A_MARGIN_PCT=80         # mode A: % of balance used as margin (85 when BTC > +3%)
DATA_DIR=/data               # where the journal database lives (mount a volume here)
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high
# FRIDAY_CLOSE_HOUR=20  FRIDAY_ALARM_HOUR=15  FRIDAY_NO_ENTRY_AFTER_HOUR=16
# MAX_HOLD_HOURS=48  ENTRY_TTL_HOURS=4  MIN_VOLUME_USD=50000000  SKIP_COINS=TAO
